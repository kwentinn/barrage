{
  "manifest_version": 3,
  "name": "Barrage pour Instagram",
  "version": "0.3.1",
  "description": "Bloque, depuis votre session instagram.com, les comptes d'une liste que vous importez : pas à pas (un clic par profil) ou en mode automatique avec garde-fous. Rien n'est envoyé hors d'Instagram.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "barrage@kwentinn.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
